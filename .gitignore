# Third-party papers (copyrighted) and unpublished manuscripts
Virtual-Coach-main/paper/

# New scenarios and local business inputs are private by default.
# Already tracked public research examples remain tracked; gitignore is not erasure.
Virtual-Coach-main/data/prompt/*
!Virtual-Coach-main/data/prompt/SampleScenario/
Virtual-Coach-main/data/prompt/SampleScenario/*
!Virtual-Coach-main/data/prompt/SampleScenario/__init__.py
!Virtual-Coach-main/data/prompt/SampleScenario/v1.py
Virtual-Coach-main/data/eval/*
Virtual-Coach-main/data/raw_docs/*
!Virtual-Coach-main/data/raw_docs/SampleScenario/
Virtual-Coach-main/data/system_context/
Virtual-Coach-main/data/trace/
Virtual-Coach-main/code/eval/eval_prompt_*.py
Virtual-Coach-main/code/workflow/prompt/ws/intergroup_*.md
上线prompt/*.tmpl
!上线prompt/example.tmpl
上线prompt/*.pdf
cross_lingual_test/results/

# Generated model adapters may contain private provider/model identifiers.
# Existing tracked adapters stay tracked; review before publishing new ones.
Virtual-Coach-main/code/models/*.py
!Virtual-Coach-main/code/models/__init__.py
!Virtual-Coach-main/code/models/api_keys_template.py

# Workflow outputs contain prompts, input data and request traces.
**/workflow_log_*.json
**/workflow_log_*.jsonl
Virtual-Coach-main/code/workflow/workflow.json
Virtual-Coach-main/code/workflow/workflow_test_input.json
Virtual-Coach-main/code/workflow/test_input.json
Virtual-Coach-main/code/workflow/analysis/analysis_node_type_and_name_data.txt
Virtual-Coach-main/code/workflow/workflow_cli_skeleton/out/

